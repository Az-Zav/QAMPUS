{
  "expo": {
    "name": "Qampus",
    "slug": "Qampus",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "qampus",
    "userInterfaceStyle": "automatic",
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#FFCC33",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "com.qampus.app",
      "googleServicesFile": "./google-services.json"
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/Qampus-Logo.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#FAF7F0",
          "image": "./assets/images/Qampus-Logo.png",
          "imageWidth": 76,
          "dark": {
            "backgroundColor": "#121110"
          }
        }
      ],
      "expo-font",
      "@react-native-google-signin/google-signin",
      "expo-dev-client",
      "expo-updates",
      [
        "expo-camera",
        {
          "cameraPermission": "Allow Qampus to use the camera to scan the office QR code and check you in.",
          "recordAudioAndroid": false
        }
      ],
      "expo-local-authentication",
      [
        "expo-notifications",
        {
          "color": "#FFC72C",
          "defaultChannel": "default"
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "867b8b05-3f0c-4360-bc86-1876ded46329"
      }
    },
    "owner": "ejayyyyy18s-team",
    "updates": {
      "url": "https://u.expo.dev/867b8b05-3f0c-4360-bc86-1876ded46329"
    },
    "ios": {}
  }
}
