rules_version = '2';
service cloud.firestore {
  match /databases/{db}/documents {
    function signedIn() { return request.auth != null; }
    function isAnon() { return request.auth.token.firebase.sign_in_provider == 'anonymous'; }
    function schoolEmail() {
      return signedIn() && !isAnon() && request.auth.token.email_verified == true
        && request.auth.token.email.matches('.*@tip[.]edu[.]ph');
    }

    // Staff are people with a staff/{email} doc, which names their office. Seeded by hand in the console.
    function staffPath() { return /databases/$(db)/documents/staff/$(request.auth.token.email); }
    function isStaff() {
      return signedIn() && request.auth.token.email_verified == true && exists(staffPath());
    }
    function staffOfficeId() { return get(staffPath()).data.office_id; }

    // The daily queue id uses the campus calendar day (campus time is UTC+8).
    function todayKey() {
      let t = request.time + duration.value(8, 'h');
      return t.year() * 10000 + t.month() * 100 + t.day();
    }

    function ticketPath(queueId, seq) {
      return /databases/$(db)/documents/tickets/$(queueId + '_' + string(seq));
    }

    function ticketDoc(ticketId) { return /databases/$(db)/documents/tickets/$(ticketId); }

    // An offense has the same id as its ticket, so a ticket can produce one offense and rules can find it.
    function offenseDoc(ticketId) { return /databases/$(db)/documents/offenses/$(ticketId); }

    // A ban lasts 24 hours from the offense. The ban end is written by the app (rules cannot add 24 h to the
    // server time inside a write), so rules accept it within half an hour of request.time + 24 h.
    function banWindow(t) {
      return t > request.time + duration.value(1410, 'm') && t < request.time + duration.value(1470, 'm');
    }

    // How a student's strikes may move (R-13): the first offense is a strike; the second resets the count to 0
    // and sets the 24-hour ban. Only moves toward a penalty are allowed here (staff revoke separately), so a
    // hand-made client can only hurt the student it belongs to.
    function penaltyMoveOk(before, after) {
      let changed = after.diff(before).affectedKeys();
      let strikes = before.get('strike_count', 0);
      return !changed.hasAny(['strike_count', 'banned_until'])
        || (changed.hasAny(['strike_count']) && !changed.hasAny(['banned_until'])
            && strikes < 1 && after.strike_count == strikes + 1)
        || (changed.hasAll(['strike_count', 'banned_until'])
            && strikes >= 1 && after.strike_count == 0 && banWindow(after.banned_until));
    }

    // Staff revoking an offense may lower the strikes to 0 or 1 and lift the ban, never extend it.
    function revokeMoveOk(before, after) {
      return after.strike_count >= 0 && after.strike_count <= 1
        && (after.get('banned_until', null) == null || after.banned_until == before.get('banned_until', null));
    }

    // Staff calling a WAITING ticket of their office: the ticket becomes CALLED and, in the same write,
    // the queue's current ticket points at it. Only while the queue is OPEN and the window is free.
    function validCall(ticketId, before, after) {
      let queuePath = /databases/$(db)/documents/queues/$(before.office_id + '_' + string(before.queue_date));
      return before.office_id == staffOfficeId()
        && before.status == 'WAITING'
        && after.diff(before).affectedKeys().hasOnly(['status', 'called_at'])
        && after.status == 'CALLED'
        && after.called_at == request.time
        && get(queuePath).data.status == 'OPEN'
        && get(queuePath).data.current_ticket_id == null
        && getAfter(queuePath).data.current_ticket_id == ticketId;
    }

    // A CALLED ticket starts service (IN_SERVICE) inside the 60 s grace period, by server time. The holder
    // does it by checking in with the office code; staff of the office do it by verifying the holder's ID.
    // The code and the ID are checked by the apps; the rules fix who, when and which fields change.
    function validArrival(before, after) {
      return (before.user_id == request.auth.uid || (isStaff() && before.office_id == staffOfficeId()))
        && before.status == 'CALLED'
        && request.time <= before.called_at + duration.value(60, 's')
        && after.diff(before).affectedKeys().hasOnly(['status', 'service_started_at'])
        && after.status == 'IN_SERVICE'
        && after.service_started_at == request.time;
    }

    // Staff finish the ticket at the window, freeing it (the queue's current ticket becomes null in the same
    // write): COMPLETED from IN_SERVICE, or NO_SHOW from a CALLED ticket after its grace period, or from an
    // IN_SERVICE ticket with a reason (verification reversed).
    function validFinish(ticketId, before, after) {
      let queuePath = /databases/$(db)/documents/queues/$(before.office_id + '_' + string(before.queue_date));
      return before.office_id == staffOfficeId()
        && get(queuePath).data.current_ticket_id == ticketId
        && getAfter(queuePath).data.current_ticket_id == null
        && ((before.status == 'IN_SERVICE'
             && after.status == 'COMPLETED'
             && after.completed_at == request.time
             && after.diff(before).affectedKeys().hasOnly(['status', 'completed_at']))
            || (after.status == 'NO_SHOW'
                && after.no_show_at == request.time
                && existsAfter(offenseDoc(ticketId))
                && after.diff(before).affectedKeys().hasOnly(['status', 'no_show_at', 'reason'])
                && ((before.status == 'CALLED' && request.time > before.called_at + duration.value(60, 's'))
                    || (before.status == 'IN_SERVICE' && after.get('reason', '').size() > 0))));
    }

    // Staff cancel the whole queue: each unfinished ticket of their office becomes CANCELLED by the OFFICE with
    // a reason, in the same write that closes the queue and clears the window.
    function validOfficeCancel(before, after) {
      let queuePath = /databases/$(db)/documents/queues/$(before.office_id + '_' + string(before.queue_date));
      return before.office_id == staffOfficeId()
        && before.status in ['WAITING', 'CALLED', 'IN_SERVICE']
        && after.diff(before).affectedKeys().hasOnly(['status', 'cancelled_by', 'cancelled_at', 'reason'])
        && after.status == 'CANCELLED'
        && after.cancelled_by == 'OFFICE'
        && after.cancelled_at == request.time
        && after.get('reason', '').size() > 0
        && getAfter(queuePath).data.status == 'CLOSED'
        && getAfter(queuePath).data.current_ticket_id == null;
    }

    // A student cancels their own ticket: free while WAITING; once CALLED it is the ticket at the window, so
    // the queue's current ticket becomes null in the same write, together with the offense (R-11).
    function validCancel(ticketId, before, after) {
      let queuePath = /databases/$(db)/documents/queues/$(before.office_id + '_' + string(before.queue_date));
      return before.user_id == request.auth.uid
        && after.diff(before).affectedKeys().hasOnly(['status', 'cancelled_by', 'cancelled_at'])
        && after.status == 'CANCELLED'
        && after.cancelled_by == 'USER'
        && after.cancelled_at == request.time
        && (before.status == 'WAITING'
            || (before.status == 'CALLED'
                && get(queuePath).data.current_ticket_id == ticketId
                && getAfter(queuePath).data.current_ticket_id == null
                && existsAfter(offenseDoc(ticketId))));
    }

    // A student joining: the ticket takes exactly the next number of an OPEN queue, in the same write
    // that bumps the queue (checked with getAfter), and its snapshot fields match the real docs.
    function validJoin(ticketId, d) {
      let queueId = d.office_id + '_' + string(d.queue_date);
      let queuePath = /databases/$(db)/documents/queues/$(queueId);
      let profile = get(/databases/$(db)/documents/users/$(request.auth.uid)).data;
      let office = get(/databases/$(db)/documents/offices/$(d.office_id)).data;
      return d.keys().hasOnly(['office_id', 'office_name', 'queue_date', 'user_id', 'holder_name',
                               'holder_institutional_id', 'daily_sequence', 'ticket_number', 'status', 'joined_at'])
        && d.user_id == request.auth.uid
        && d.queue_date == todayKey()
        && ticketId == queueId + '_' + string(d.daily_sequence)
        && d.status == 'WAITING'
        && d.joined_at == request.time
        && get(queuePath).data.status == 'OPEN'
        && get(queuePath).data.last_seq == d.daily_sequence - 1
        && getAfter(queuePath).data.last_seq == d.daily_sequence
        && profile.get('institutional_id', null) != null
        && d.holder_institutional_id == profile.institutional_id
        && d.holder_name == profile.name
        && (profile.get('banned_until', null) == null || profile.banned_until <= request.time)
        && profile.get('active_count', 0) < 3
        && !(d.office_id in profile.get('active_offices', {}))
        && d.office_id in getAfter(/databases/$(db)/documents/users/$(request.auth.uid)).data.active_offices
        && getAfter(/databases/$(db)/documents/users/$(request.auth.uid)).data.active_count == profile.get('active_count', 0) + 1
        && office.status == 'ACTIVE'
        && d.office_name == office.name
        && d.ticket_number.matches('^' + office.code + '-[0-9]{2}-[0-9]{2}-[0-9]{3,}$');
    }

    // An offense is created only together with the ticket change that causes it (R-11): the holder cancelling a
    // CALLED ticket, or staff of the office marking a CALLED or IN_SERVICE ticket a no-show. It copies the
    // ticket's fields, says whether it caused a ban, and the holder's strikes move accordingly in the same write.
    function validOffense(ticketId, d) {
      let t = get(ticketDoc(ticketId)).data;
      let tAfter = getAfter(ticketDoc(ticketId)).data;
      let holder = /databases/$(db)/documents/users/$(t.user_id);
      let strikes = get(holder).data.get('strike_count', 0);
      return d.keys().hasOnly(['user_id', 'ticket_id', 'office_id', 'office_name', 'ticket_number', 'holder_name',
                               'holder_institutional_id', 'type', 'resulted_in_ban', 'revoked_by', 'revoked_at',
                               'created_at'])
        && d.ticket_id == ticketId
        && d.user_id == t.user_id
        && d.office_id == t.office_id
        && d.office_name == t.office_name
        && d.ticket_number == t.ticket_number
        && d.holder_name == t.holder_name
        && d.holder_institutional_id == t.holder_institutional_id
        && d.created_at == request.time
        && d.revoked_at == null
        && d.revoked_by == null
        && d.resulted_in_ban == (strikes >= 1)
        && getAfter(holder).data.strike_count == (d.resulted_in_ban ? 0 : strikes + 1)
        && ((d.type == 'CANCELLED_AFTER_CALL'
             && request.auth.uid == t.user_id
             && t.status == 'CALLED'
             && tAfter.status == 'CANCELLED')
            || (d.type == 'NO_SHOW'
                && isStaff()
                && t.office_id == staffOfficeId()
                && t.status in ['CALLED', 'IN_SERVICE']
                && tAfter.status == 'NO_SHOW'));
    }

    // Staff of the office revoke one of its offenses (R-15) with a reason; the record stays.
    function validRevoke(before, after) {
      return before.office_id == staffOfficeId()
        && before.get('revoked_at', null) == null
        && after.diff(before).affectedKeys().hasOnly(['revoked_at', 'revoked_by', 'revoke_reason'])
        && after.revoked_at == request.time
        && after.revoked_by == request.auth.token.email
        && after.get('revoke_reason', '').size() > 0;
    }

    // Students and guests: own document only. Role is fixed at create. Strikes and bans start at 0 and null and
    // move only as penaltyMoveOk allows (toward a penalty) or when staff revoke an offense. The open-ticket
    // count moves only by one at a time (see below).
    match /users/{uid} {
      allow read: if signedIn() && request.auth.uid == uid;
      // Staff read one student profile at a time (never a list): recording an offense needs the strike count.
      allow get: if isStaff();
      allow create: if signedIn() && request.auth.uid == uid
        && request.resource.data.strike_count == 0 && request.resource.data.banned_until == null
        && request.resource.data.active_count == 0
        && ((isAnon() && request.resource.data.role == 'GUEST')
         || (schoolEmail() && request.resource.data.role == 'STUDENT'));
      allow update: if (signedIn() && request.auth.uid == uid
            && !request.resource.data.diff(resource.data).affectedKeys().hasAny(['role', 'strike_count', 'banned_until', 'active_count', 'active_offices'])
            && (resource.data.get('institutional_id', null) == null
            || request.resource.data.get('institutional_id', null) == resource.data.get('institutional_id', null)))
        // The three-ticket limit (R-07) is this counter, and `active_offices` (office id -> true) holds the offices
        // where the student has an active ticket, so they cannot join the same office twice. A student moves the
        // counter by one, within 0..3: a join must raise it and add its office in the same write (see the ticket
        // rules); finishing or cancelling lowers it and clears the office. Rules cannot tell why they moved, so a
        // hand-made client could cheat; fine for a prototype.
        || (signedIn() && request.auth.uid == uid
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['active_count', 'active_offices', 'strike_count', 'banned_until'])
            && request.resource.data.active_count >= 0
            && request.resource.data.active_count <= 3
            && (request.resource.data.active_count == resource.data.get('active_count', 0) + 1
                || request.resource.data.active_count == resource.data.get('active_count', 0) - 1)
            && penaltyMoveOk(resource.data, request.resource.data))
        // Staff give a slot back when they finish a ticket (complete, no-show, office cancel); a no-show also
        // moves the student's strikes.
        || (isStaff()
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['active_count', 'active_offices', 'strike_count', 'banned_until'])
            && request.resource.data.active_count >= 0
            && request.resource.data.active_count == resource.data.get('active_count', 0) - 1
            && penaltyMoveOk(resource.data, request.resource.data))
        // Staff revoke an offense: strikes down and the ban lifted (R-15).
        || (isStaff()
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['strike_count', 'banned_until'])
            && revokeMoveOk(resource.data, request.resource.data));
    }

    // A user reads only the doc whose id is their own email.
    match /staff/{email} {
      allow read: if signedIn() && request.auth.token.email == email;
    }

    // Offices are seeded by hand; any signed-in user may read them, nobody writes from a client.
    match /offices/{officeId} {
      allow read: if signedIn();
    }

    // queues/{officeId}_{yyyymmdd}. No doc for today means staff have not opened the queue.
    match /queues/{queueId} {
      allow read: if signedIn();

      // Staff open today's queue for their own office (the first open of the day creates it).
      allow create: if isStaff()
        && queueId == staffOfficeId() + '_' + string(todayKey())
        && request.resource.data.keys().hasOnly(['status', 'last_seq', 'last_called_seq', 'current_ticket_id',
                                                 'cutoff_overridden', 'completed_count', 'service_seconds_total',
                                                 'created_at', 'updated_at'])
        && request.resource.data.status == 'OPEN'
        && request.resource.data.last_seq == 0
        && request.resource.data.last_called_seq == 0
        && request.resource.data.current_ticket_id == null
        && request.resource.data.cutoff_overridden == false
        && request.resource.data.completed_count == 0
        && request.resource.data.service_seconds_total == 0
        && request.resource.data.created_at == request.time
        && request.resource.data.updated_at == request.time;

      allow update:
        // Staff open or close their own office's queue.
        if (isStaff()
            && queueId.matches(staffOfficeId() + '_[0-9]{8}')
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'updated_at'])
            && request.resource.data.status in ['OPEN', 'CLOSED']
            && request.resource.data.updated_at == request.time)
        // A student takes the next number, only together with their own new ticket.
        || (signedIn()
            && resource.data.status == 'OPEN'
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['last_seq', 'updated_at'])
            && request.resource.data.last_seq == resource.data.last_seq + 1
            && request.resource.data.updated_at == request.time
            && existsAfter(ticketPath(queueId, request.resource.data.last_seq))
            && getAfter(ticketPath(queueId, request.resource.data.last_seq)).data.user_id == request.auth.uid)
        // Staff call a ticket: the queue points at it and its number moves the last called number up.
        || (isStaff()
            && queueId.matches(staffOfficeId() + '_[0-9]{8}')
            && resource.data.status == 'OPEN'
            && resource.data.current_ticket_id == null
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['last_called_seq', 'current_ticket_id', 'updated_at'])
            && request.resource.data.current_ticket_id.matches(queueId + '_[0-9]+')
            && request.resource.data.updated_at == request.time
            && get(ticketDoc(request.resource.data.current_ticket_id)).data.status == 'WAITING'
            && getAfter(ticketDoc(request.resource.data.current_ticket_id)).data.status == 'CALLED'
            && getAfter(ticketDoc(request.resource.data.current_ticket_id)).data.office_id == staffOfficeId()
            && request.resource.data.last_called_seq ==
                (getAfter(ticketDoc(request.resource.data.current_ticket_id)).data.daily_sequence > resource.data.last_called_seq
                  ? getAfter(ticketDoc(request.resource.data.current_ticket_id)).data.daily_sequence
                  : resource.data.last_called_seq))
        // Staff free the window after a no-show: the current ticket becomes null.
        || (isStaff()
            && queueId.matches(staffOfficeId() + '_[0-9]{8}')
            && resource.data.current_ticket_id != null
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['current_ticket_id', 'updated_at'])
            && request.resource.data.current_ticket_id == null
            && request.resource.data.updated_at == request.time
            && getAfter(ticketDoc(resource.data.current_ticket_id)).data.status == 'NO_SHOW')
        // Staff free the window after completing: it also counts the visit and adds its length.
        || (isStaff()
            && queueId.matches(staffOfficeId() + '_[0-9]{8}')
            && resource.data.current_ticket_id != null
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['current_ticket_id', 'completed_count', 'service_seconds_total', 'updated_at'])
            && request.resource.data.current_ticket_id == null
            && request.resource.data.completed_count == resource.data.completed_count + 1
            && request.resource.data.service_seconds_total >= resource.data.service_seconds_total
            && request.resource.data.updated_at == request.time
            && getAfter(ticketDoc(resource.data.current_ticket_id)).data.status == 'COMPLETED')
        // A student cancels the ticket at the window: it becomes null (their own ticket only).
        || (signedIn()
            && resource.data.current_ticket_id != null
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['current_ticket_id', 'updated_at'])
            && request.resource.data.current_ticket_id == null
            && request.resource.data.updated_at == request.time
            && get(ticketDoc(resource.data.current_ticket_id)).data.user_id == request.auth.uid
            && getAfter(ticketDoc(resource.data.current_ticket_id)).data.status == 'CANCELLED')
        // Staff cancel the whole queue: it closes and the window clears (the current ticket is cancelled too).
        || (isStaff()
            && queueId.matches(staffOfficeId() + '_[0-9]{8}')
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'current_ticket_id', 'updated_at'])
            && request.resource.data.status == 'CLOSED'
            && request.resource.data.current_ticket_id == null
            && request.resource.data.updated_at == request.time
            && (resource.data.current_ticket_id == null
                || getAfter(ticketDoc(resource.data.current_ticket_id)).data.status == 'CANCELLED'));
    }

    // tickets/{queueId}_{seq}. Students join and cancel (WAITING or CALLED); staff call, finish, cancel the queue; the holder or staff start service.
    match /tickets/{ticketId} {
      allow read: if signedIn()
        && (resource.data.user_id == request.auth.uid
            || (isStaff() && resource.data.office_id == staffOfficeId()));
      allow create: if signedIn() && validJoin(ticketId, request.resource.data);
      allow update: if (isStaff() && validCall(ticketId, resource.data, request.resource.data))
        || (signedIn() && validArrival(resource.data, request.resource.data))
        || (isStaff() && validFinish(ticketId, resource.data, request.resource.data))
        || (signedIn() && validCancel(ticketId, resource.data, request.resource.data))
        || (isStaff() && validOfficeCancel(resource.data, request.resource.data));
    }

    // offenses/{ticketId}. The holder reads their own; staff read their office's. Created with the ticket change
    // that causes it, revoked (not deleted) by staff of the office.
    match /offenses/{ticketId} {
      allow read: if signedIn()
        && (resource.data.user_id == request.auth.uid
            || (isStaff() && resource.data.office_id == staffOfficeId()));
      allow create: if signedIn() && validOffense(ticketId, request.resource.data);
      allow update: if isStaff() && validRevoke(resource.data, request.resource.data);
    }
  }
}
