rules_version = '2';
service cloud.firestore {
  match /databases/{db}/documents {
    function signedIn() { return request.auth != null; }
    function isAnon() { return request.auth.token.firebase.sign_in_provider == 'anonymous'; }
    function schoolEmail() {
      return signedIn() && !isAnon() && request.auth.token.email_verified == true
        && request.auth.token.email.matches('.*@tip[.]edu[.]ph');
    }

    // Staff are people with a staff/{email} doc, which names their office. Seeded by hand in the console.
    function staffPath() { return /databases/$(db)/documents/staff/$(request.auth.token.email); }
    function isStaff() {
      return signedIn() && request.auth.token.email_verified == true && exists(staffPath());
    }
    function staffOfficeId() { return get(staffPath()).data.office_id; }

    // The daily queue id uses the campus calendar day (campus time is UTC+8).
    function todayKey() {
      let t = request.time + duration.value(8, 'h');
      return t.year() * 10000 + t.month() * 100 + t.day();
    }

    function ticketPath(queueId, seq) {
      return /databases/$(db)/documents/tickets/$(queueId + '_' + string(seq));
    }

    function ticketDoc(ticketId) { return /databases/$(db)/documents/tickets/$(ticketId); }

    // Staff calling a WAITING ticket of their office: the ticket becomes CALLED and, in the same write,
    // the queue's current ticket points at it. Only while the queue is OPEN and the window is free.
    function validCall(ticketId, before, after) {
      let queuePath = /databases/$(db)/documents/queues/$(before.office_id + '_' + string(before.queue_date));
      return before.office_id == staffOfficeId()
        && before.status == 'WAITING'
        && after.diff(before).affectedKeys().hasOnly(['status', 'called_at'])
        && after.status == 'CALLED'
        && after.called_at == request.time
        && get(queuePath).data.status == 'OPEN'
        && get(queuePath).data.current_ticket_id == null
        && getAfter(queuePath).data.current_ticket_id == ticketId;
    }

    // A CALLED ticket starts service (IN_SERVICE) inside the 60 s grace period, by server time. The holder
    // does it by checking in with the office code; staff of the office do it by verifying the holder's ID.
    // The code and the ID are checked by the apps; the rules fix who, when and which fields change.
    function validArrival(before, after) {
      return (before.user_id == request.auth.uid || (isStaff() && before.office_id == staffOfficeId()))
        && before.status == 'CALLED'
        && request.time <= before.called_at + duration.value(60, 's')
        && after.diff(before).affectedKeys().hasOnly(['status', 'service_started_at'])
        && after.status == 'IN_SERVICE'
        && after.service_started_at == request.time;
    }

    // A student joining: the ticket takes exactly the next number of an OPEN queue, in the same write
    // that bumps the queue (checked with getAfter), and its snapshot fields match the real docs.
    function validJoin(ticketId, d) {
      let queueId = d.office_id + '_' + string(d.queue_date);
      let queuePath = /databases/$(db)/documents/queues/$(queueId);
      let profile = get(/databases/$(db)/documents/users/$(request.auth.uid)).data;
      let office = get(/databases/$(db)/documents/offices/$(d.office_id)).data;
      return d.keys().hasOnly(['office_id', 'office_name', 'queue_date', 'user_id', 'holder_name',
                               'holder_institutional_id', 'daily_sequence', 'ticket_number', 'status', 'joined_at'])
        && d.user_id == request.auth.uid
        && d.queue_date == todayKey()
        && ticketId == queueId + '_' + string(d.daily_sequence)
        && d.status == 'WAITING'
        && d.joined_at == request.time
        && get(queuePath).data.status == 'OPEN'
        && get(queuePath).data.last_seq == d.daily_sequence - 1
        && getAfter(queuePath).data.last_seq == d.daily_sequence
        && profile.get('institutional_id', null) != null
        && d.holder_institutional_id == profile.institutional_id
        && d.holder_name == profile.name
        && office.status == 'ACTIVE'
        && d.office_name == office.name
        && d.ticket_number.matches('^' + office.code + '-[0-9]{2}-[0-9]{2}-[0-9]{3,}$');
    }

    // Students and guests: own document only. Role, strikes, bans and the open-ticket count are
    // fixed at create and never writable by the client (docs/SCHEMA.md, users).
    match /users/{uid} {
      allow read: if signedIn() && request.auth.uid == uid;
      allow create: if signedIn() && request.auth.uid == uid
        && request.resource.data.strike_count == 0 && request.resource.data.banned_until == null
        && request.resource.data.active_count == 0
        && ((isAnon() && request.resource.data.role == 'GUEST')
         || (schoolEmail() && request.resource.data.role == 'STUDENT'));
      allow update: if signedIn() && request.auth.uid == uid
        && !request.resource.data.diff(resource.data).affectedKeys().hasAny(['role', 'strike_count', 'banned_until', 'active_count'])
        && (resource.data.get('institutional_id', null) == null
        || request.resource.data.get('institutional_id', null) == resource.data.get('institutional_id', null));
    }

    // A user reads only the doc whose id is their own email.
    match /staff/{email} {
      allow read: if signedIn() && request.auth.token.email == email;
    }

    // Offices are seeded by hand; any signed-in user may read them, nobody writes from a client.
    match /offices/{officeId} {
      allow read: if signedIn();
    }

    // queues/{officeId}_{yyyymmdd}. No doc for today means staff have not opened the queue.
    match /queues/{queueId} {
      allow read: if signedIn();

      // Staff open today's queue for their own office (the first open of the day creates it).
      allow create: if isStaff()
        && queueId == staffOfficeId() + '_' + string(todayKey())
        && request.resource.data.keys().hasOnly(['status', 'last_seq', 'last_called_seq', 'current_ticket_id',
                                                 'cutoff_overridden', 'completed_count', 'service_seconds_total',
                                                 'created_at', 'updated_at'])
        && request.resource.data.status == 'OPEN'
        && request.resource.data.last_seq == 0
        && request.resource.data.last_called_seq == 0
        && request.resource.data.current_ticket_id == null
        && request.resource.data.cutoff_overridden == false
        && request.resource.data.completed_count == 0
        && request.resource.data.service_seconds_total == 0
        && request.resource.data.created_at == request.time
        && request.resource.data.updated_at == request.time;

      allow update:
        // Staff open or close their own office's queue.
        if (isStaff()
            && queueId.matches(staffOfficeId() + '_[0-9]{8}')
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'updated_at'])
            && request.resource.data.status in ['OPEN', 'CLOSED']
            && request.resource.data.updated_at == request.time)
        // A student takes the next number, only together with their own new ticket.
        || (signedIn()
            && resource.data.status == 'OPEN'
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['last_seq', 'updated_at'])
            && request.resource.data.last_seq == resource.data.last_seq + 1
            && request.resource.data.updated_at == request.time
            && existsAfter(ticketPath(queueId, request.resource.data.last_seq))
            && getAfter(ticketPath(queueId, request.resource.data.last_seq)).data.user_id == request.auth.uid)
        // Staff call a ticket: the queue points at it and its number moves the last called number up.
        || (isStaff()
            && queueId.matches(staffOfficeId() + '_[0-9]{8}')
            && resource.data.status == 'OPEN'
            && resource.data.current_ticket_id == null
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['last_called_seq', 'current_ticket_id', 'updated_at'])
            && request.resource.data.current_ticket_id.matches(queueId + '_[0-9]+')
            && request.resource.data.updated_at == request.time
            && get(ticketDoc(request.resource.data.current_ticket_id)).data.status == 'WAITING'
            && getAfter(ticketDoc(request.resource.data.current_ticket_id)).data.status == 'CALLED'
            && getAfter(ticketDoc(request.resource.data.current_ticket_id)).data.office_id == staffOfficeId()
            && request.resource.data.last_called_seq ==
                (getAfter(ticketDoc(request.resource.data.current_ticket_id)).data.daily_sequence > resource.data.last_called_seq
                  ? getAfter(ticketDoc(request.resource.data.current_ticket_id)).data.daily_sequence
                  : resource.data.last_called_seq));
    }

    // tickets/{queueId}_{seq}. Students create (join); staff call; the holder or staff start service. Nothing else yet.
    match /tickets/{ticketId} {
      allow read: if signedIn()
        && (resource.data.user_id == request.auth.uid
            || (isStaff() && resource.data.office_id == staffOfficeId()));
      allow create: if signedIn() && validJoin(ticketId, request.resource.data);
      allow update: if (isStaff() && validCall(ticketId, resource.data, request.resource.data))
        || (signedIn() && validArrival(resource.data, request.resource.data));
    }
  }
}
