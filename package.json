{
  "name": "qampus-monorepo",
  "private": true,
  "version": "1.0.0",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "mobile": "npm run start --workspace @qampus/mobile",
    "staff": "npm run web --workspace @qampus/staff",
    "lint": "npm run lint --workspaces --if-present"
  },
  "dependencies": {
    "expo": "~57.0.25",
    "react": "19.2.3",
    "react-native": "0.86.3"
  }
}
